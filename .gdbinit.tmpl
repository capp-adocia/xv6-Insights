设置 $lastcs = -1

define hook-stop
  # 似乎没有好的方法来检测我们是在16位还是32位模式下，
  # 但在32位模式下，我们在内核中总是用 CS == 8，在用户空间为 CS == 35
  if $cs == 8 || $cs == 35
    if $lastcs != 8 && $lastcs != 35
      设置架构 i386
    end
    x/i $pc
  else
    if $lastcs == -1 || $lastcs == 8 || $lastcs == 35
      设置架构 i8086
    end
    # 将段:偏移转换为物理地址
    printf "[%4x:%4x] ", $cs, $eip
    x/i $cs*16+$eip
  end
  设置 $lastcs = $cs
end

echo + target remote localhost:1234\n
target remote localhost:1234

echo + symbol-file kernel\n
symbol-file kernel